# Copy to .env and fill in. Never commit .env.

# --- OpenCrawl (hosted MCP: https://app.getopencrawl.com/mcp) ---
OPENCRAWL_API_KEY=your_opencrawl_key
OPENCRAWL_MCP_URL=https://app.getopencrawl.com/mcp
# Optional: force a specific OpenCrawl tool name if auto-discovery picks the wrong one
# (list tools with: python -m backend.tools.opencrawl_client)
OPENCRAWL_TOOL=

# --- You.com (Search, Contents, Research) ---
YOU_API_KEY=your_you_com_key
# Hosted MCP endpoint used by .mcp.json (verify against You.com docs)
YOU_MCP_URL=https://api.you.com/mcp
# REST endpoints used by backend/tools/you_client.py (verify against You.com docs)
YOU_SEARCH_URL=https://api.ydc-index.io/search
YOU_CONTENTS_URL=https://ydc-index.io/v1/contents
YOU_RESEARCH_URL=https://api.you.com/v1/research

# --- Optional: LLM-written outreach drafts (a deterministic template is used if unset) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Live Wire watcher ---
WATCHER_ENABLED=true
POLL_INTERVAL_SECONDS=300
# Optional outbound webhooks fired on Transition A (leave empty to skip)
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# --- App ---
DATABASE_PATH=./jobverify.db
BACKEND_CORS_ORIGINS=http://localhost:3000
HTTP_TIMEOUT_SECONDS=20
OPENCRAWL_TIMEOUT_SECONDS=60
LOG_LEVEL=INFO
